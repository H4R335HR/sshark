#!/usr/bin/env python3
# sshark-web: run sshark over HTTP. The URL path is the command line.
#   curl <gateway-ip>/status
#   curl <gateway-ip>/list/india
#   curl <gateway-ip>/connect/sg-sng
#   curl <gateway-ip>/best/japan
# Arguments go to sshark as a list (no shell), so nothing in the URL is ever interpreted by sh.
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote

SSHARK = "/usr/local/sbin/sshark"

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        args = [unquote(p) for p in path.strip("/").split("/") if p] or ["status"]
        if args[0] == "favicon.ico":
            self.send_response(404); self.end_headers(); return
        r = subprocess.run([SSHARK, *args], capture_output=True, text=True, timeout=180)
        body = (r.stdout + r.stderr).encode()
        self.send_response(200 if r.returncode == 0 else 500)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

ThreadingHTTPServer(("0.0.0.0", 80), Handler).serve_forever()
